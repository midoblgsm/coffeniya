# Copy to .env.local for local development against a real Firebase project,
# or leave unset and use `npm run emulators` + VITE_USE_EMULATORS=true.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Set to 'true' to point the app at the local Firebase emulator suite.
VITE_USE_EMULATORS=
